        "# Phishing URL Detector\n",
        "\n",
        "from urllib.parse import urlparse\n",
        "import ipaddress\n",
        "\n",
        "def detect_phishing(url):\n",
        "    indicators = []\n",
        "    parsed = urlparse(url if \"://\" in url else \"http://\" + url)\n",
        "    host = parsed.hostname or \"\"\n",
        "\n",
        "    keywords = [\"login\", \"verify\", \"password\", \"secure\",\n",
        "                \"update\", \"bank\", \"free\"]\n",
        "\n",
        "    if any(word in url.lower() for word in keywords):\n",
        "        indicators.append(\"Suspicious keyword\")\n",
        "\n",
        "    try:\n",
        "        ipaddress.ip_address(host)\n",
        "        indicators.append(\"IP-based domain\")\n",
        "    except ValueError:\n",
        "        pass\n",
        "\n",
        "    if len(host.split(\".\")) > 3:\n",
        "        indicators.append(\"Excessive subdomains\")\n",
        "\n",
        "    if \"@\" in parsed.netloc:\n",
        "        indicators.append(\"Contains @ symbol\")\n",
        "\n",
        "    if parsed.scheme == \"http\":\n",
        "        indicators.append(\"Uses HTTP instead of HTTPS\")\n",
        "\n",
        "    if indicators:\n",
        "        print(\"Warning: Potentially suspicious URL\")\n",
        "        print(\"Indicators found:\")\n",
        "        for item in indicators:\n",
        "            print(\"-\", item)\n",
        "    else:\n",
        "        print(\"No common phishing indicators detected\")\n",
        "\n",
        "url = input(\"Enter URL to check: \")\n",
        "detect_phishing(url)"
      ]
