        "# Classify Threat Intelligence Reports\n",
        "\n",
        "def classify_report(description, audience):\n",
        "    text = (description + \" \" + audience).lower()\n",
        "\n",
        "    if any(word in text for word in\n",
        "           [\"ceo\", \"executive\", \"business strategy\", \"long-term\"]):\n",
        "        return \"Strategic\"\n",
        "\n",
        "    elif any(word in text for word in\n",
        "             [\"ioc\", \"ip address\", \"hash\", \"signature\", \"tactic\"]):\n",
        "        return \"Tactical\"\n",
        "\n",
        "    elif any(word in text for word in\n",
        "             [\"soc analyst\", \"incident response\", \"alert\", \"immediate\"]):\n",
        "        return \"Operational\"\n",
        "\n",
        "    return \"Operational\"\n",
        "\n",
        "description = input(\"Enter report description: \")\n",
        "audience = input(\"Enter intended audience: \")\n",
        "\n",
        "result = classify_report(description, audience)\n",
        "print(\"Report Classification:\", result)"
      ]
