        "# Threat Intelligence Quality Assessment\n",
        "\n",
        "context = input(\"Enter threat context: \")\n",
        "confidence = int(input(\"Enter confidence level (0-100): \"))\n",
        "action = input(\"Enter recommended action: \")\n",
        "\n",
        "if context.strip() and confidence >= 70 and action.strip():\n",
        "    print(\"Result: Actionable Threat Intelligence\")\n",
        "    print(\"Context:\", context)\n",
        "    print(\"Confidence:\", confidence, \"%\")\n",
        "    print(\"Recommended Action:\", action)\n",
        "else:\n",
        "    print(\"Result: Raw or Incomplete Threat Data\")\n",
        "    if not context.strip():\n",
        "        print(\"- Context is missing\")\n",
        "    if confidence < 70:\n",
        "        print(\"- Confidence is too low\")\n",
        "    if not action.strip():\n",
        "        print(\"- Actionable recommendation is missing\")"
