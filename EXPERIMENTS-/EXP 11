        "# Packet Sniffing Using Scapy\n",
        "\n",
        "!pip -q install scapy\n",
        "\n",
        "from scapy.all import sniff\n",
        "\n",
        "def show_packet(packet):\n",
        "    print(packet.summary())\n",
        "\n",
        "print(\"Capturing up to 10 packets...\")\n",
        "try:\n",
        "    packets = sniff(count=10, timeout=15, prn=show_packet)\n",
        "    print(\"Total packets captured:\", len(packets))\n",
        "except Exception as e:\n",
        "    print(\"Packet capture failed:\", e)\n",
        "    print(\"Try running in a local environment with permission.\")"
      ]
