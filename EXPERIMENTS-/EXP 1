      "source": [
        "# Identify the threat-intelligence application area\n",
        "\n",
        "scenario = input(\"Enter a business scenario: \").lower()\n",
        "\n",
        "if any(word in scenario for word in [\"bank\", \"banking\", \"financial\", \"payment\", \"transaction\"]):\n",
        "    print(\"Application Area: Banking Fraud Prevention\")\n",
        "elif any(word in scenario for word in [\"hospital\", \"healthcare\", \"medical\", \"patient\"]):\n",
        "    print(\"Application Area: Healthcare Data Protection\")\n",
        "elif any(word in scenario for word in [\"e-commerce\", \"ecommerce\", \"online shopping\", \"retail\"]):\n",
        "    print(\"Application Area: E-commerce Fraud Prevention\")\n",
        "elif any(word in scenario for word in [\"college\", \"school\", \"university\", \"student\"]):\n",
        "    print(\"Application Area: Educational Data Protection\")\n",
        "else:\n",
        "    print(\"Application Area: General Cyber Threat Monitoring\")"
      ]
    }
