      "source": [
        "# SOC Alert Priority Classifier\n",
        "\n",
        "def classify_alert(alert):\n",
        "    alert = alert.lower()\n",
        "\n",
        "    if any(word in alert for word in\n",
        "           [\"ransomware\", \"data breach\", \"active attack\", \"critical\"]):\n",
        "        return \"P1 - Critical\"\n",
        "\n",
        "    elif any(word in alert for word in\n",
        "             [\"malware\", \"unauthorized access\", \"multiple failed logins\"]):\n",
        "        return \"P2 - High\"\n",
        "\n",
        "    elif any(word in alert for word in\n",
        "             [\"suspicious login\", \"port scan\", \"unusual activity\"]):\n",
        "        return \"P3 - Medium\"\n",
        "\n",
        "    else:\n",
        "        return \"P4 - Low\"\n",
        "\n",
        "alert = input(\"Enter SOC alert description: \")\n",
        "print(\"Alert Priority:\", classify_alert(alert))"
      ]
    }
