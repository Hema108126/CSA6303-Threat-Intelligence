            "Network Segmentation Test\n",
            "\n",
            "ACCESS ALLOWED: Low_Trust -> Internet\n",
            "ACCESS BLOCKED: Low_Trust -> Sensitive\n",
            "ACCESS ALLOWED: Employee -> Application_Server\n",
            "ACCESS BLOCKED: Employee -> Sensitive\n",
            "ACCESS BLOCKED: Authorized_Admin -> Sensitive\n"
          ]
        }
      ],
      "source": [
        "# Network Segmentation Access Policy\n",
        "\n",
        "network_policy = {\n",
        "    \"Low_Trust\": [\"Internet\"],\n",
        "    \"Employee\": [\"Internet\", \"Application_Server\"],\n",
        "    \"Sensitive\": [\"Authorized_Admin\"]\n",
        "}\n",
        "\n",
        "def check_access(source, destination):\n",
        "    allowed = network_policy.get(source, [])\n",
        "\n",
        "    if destination in allowed:\n",
        "        print(\"ACCESS ALLOWED:\", source, \"->\", destination)\n",
        "    else:\n",
        "        print(\"ACCESS BLOCKED:\", source, \"->\", destination)\n",
        "\n",
        "print(\"Network Segmentation Test\\n\")\n",
        "\n",
        "check_access(\"Low_Trust\", \"Internet\")\n",
        "check_access(\"Low_Trust\", \"Sensitive\")\n",
        "check_access(\"Employee\", \"Application_Server\")\n",
        "check_access(\"Employee\", \"Sensitive\")\n",
        "check_access(\"Authorized_Admin\", \"Sensitive\")"
      ]
    }
  ]
