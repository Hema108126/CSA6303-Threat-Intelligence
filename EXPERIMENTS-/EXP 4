        "# VPN Confidentiality Demonstration\n",
        "\n",
        "def encrypt(text, key):\n",
        "    return bytes([ord(c) ^ key for c in text])\n",
        "\n",
        "def decrypt(data, key):\n",
        "    return ''.join(chr(b ^ key) for b in data)\n",
        "\n",
        "message = \"Secret VPN Data\"\n",
        "key = 25\n",
        "\n",
        "encrypted = encrypt(message, key)\n",
        "\n",
        "print(\"Original Data:\", message)\n",
        "print(\"Captured Data (Encrypted):\", encrypted)\n",
        "print(\"Without Key:\", encrypted.decode('latin-1'))\n",
        "print(\"With Shared Key:\", decrypt(encrypted, key))"
      ]
    }
