      "source": [
        "# Stateful Firewall Simulation\n",
        "\n",
        "active_connections = set()\n",
        "\n",
        "def firewall(direction, source, destination):\n",
        "    connection = (source, destination)\n",
        "    reverse_connection = (destination, source)\n",
        "\n",
        "    if direction == \"OUTBOUND\":\n",
        "        active_connections.add(connection)\n",
        "        print(\"ALLOWED: Outbound connection created\")\n",
        "\n",
        "    elif direction == \"INBOUND\":\n",
        "        if reverse_connection in active_connections:\n",
        "            print(\"ALLOWED: Return traffic for established connection\")\n",
        "        else:\n",
        "            print(\"BLOCKED: Unsolicited inbound traffic\")\n",
        "\n",
        "firewall(\"OUTBOUND\", \"PC1:5000\", \"Server:80\")\n",
        "firewall(\"INBOUND\", \"Server:80\", \"PC1:5000\")\n",
        "firewall(\"INBOUND\", \"Unknown:9000\", \"PC1:5000\")"
      ]
    }
