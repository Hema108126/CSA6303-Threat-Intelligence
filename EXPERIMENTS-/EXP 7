        "# ELK Stack Simulation\n",
        "import re\n",
        "from collections import Counter\n",
        "\n",
        "logs = [\n",
        "    \"192.168.1.1 GET /home 200\",\n",
        "    \"192.168.1.2 POST /login 401\",\n",
        "    \"192.168.1.3 GET /home 200\",\n",
        "    \"192.168.1.4 POST /login 500\"\n",
        "]\n",
        "\n",
        "# Logstash: Parse raw logs\n",
        "events = []\n",
        "\n",
        "for log in logs:\n",
        "    match = re.match(r\"(\\S+)\\s+(\\S+)\\s+(\\S+)\\s+(\\d+)\", log)\n",
        "    if match:\n",
        "        ip, method, path, status = match.groups()\n",
        "        events.append({\n",
        "            \"ip\": ip,\n",
        "            \"method\": method,\n",
        "            \"path\": path,\n",
        "            \"status\": int(status)\n",
        "        })\n",
        "\n",
        "print(\"Logstash - Parsed Events:\")\n",
        "for event in events:\n",
        "    print(event)\n",
        "\n",
        "# Elasticsearch: Index structured events\n",
        "index = {i: event for i, event in enumerate(events)}\n",
        "print(\"\\nElasticsearch - Indexed Events:\", len(index))\n",
        "\n",
        "# Kibana: Aggregate and display results\n",
        "status_counts = Counter(\n",
        "    event[\"status\"] for event in index.values()\n",
        ")\n",
        "\n",
        "print(\"\\nKibana - HTTP Status Summary:\")\n",
        "for status, count in sorted(status_counts.items()):\n",
        "    print(status, \":\", count)\n",
        "\n",
        "errors = sum(1 for event in index.values()\n",
        "             if event[\"status\"] >= 400)\n",
        "print(\"Total Failed Requests:\", errors)"
      ]
    }
  ]
