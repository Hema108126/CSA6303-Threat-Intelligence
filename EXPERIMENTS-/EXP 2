      "source": [
        "# Simple Port Scanner\n",
        "import socket\n",
        "\n",
        "host = input(\"Enter target hostname or IP: \")\n",
        "\n",
        "ports = [21, 22, 23, 25, 53, 80, 110, 443, 3306, 8080]\n",
        "\n",
        "print(\"\\nScanning target:\", host)\n",
        "\n",
        "for port in ports:\n",
        "    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n",
        "    s.settimeout(0.5)\n",
        "\n",
        "    result = s.connect_ex((host, port))\n",
        "\n",
        "    if result == 0:\n",
        "        print(\"Port\", port, \"is OPEN\")\n",
        "    else:\n",
        "        print(\"Port\", port, \"is CLOSED or FILTERED\")\n",
        "\n",
        "    s.close()\n",
        "\n",
        "print(\"Scan completed.\")\n"
      ]
