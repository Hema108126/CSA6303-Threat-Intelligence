      "source": [
        "# Classify Threat Intelligence Lifecycle Stages\n",
        "\n",
        "def classify_stage(activity):\n",
        "    activity = activity.lower()\n",
        "\n",
        "    keywords = {\n",
        "        \"Direction\": [\"goal\", \"requirement\", \"planning\", \"priority\"],\n",
        "        \"Collection\": [\"collect\", \"gather\", \"logs\", \"sources\"],\n",
        "        \"Processing\": [\"clean\", \"filter\", \"organize\", \"normalize\"],\n",
        "        \"Analysis\": [\"analyze\", \"investigate\", \"correlate\", \"identify\"],\n",
        "        \"Dissemination\": [\"share\", \"report\", \"distribute\", \"send\"],\n",
        "        \"Feedback\": [\"feedback\", \"review\", \"improve\", \"evaluate\"]\n",
        "    }\n",
        "\n",
        "    for stage, words in keywords.items():\n",
        "        if any(word in activity for word in words):\n",
        "            return stage\n",
        "\n",
        "    return \"Stage not identified\"\n",
        "\n",
        "activity = input(\"Enter intelligence team activity: \")\n",
        "print(\"Lifecycle Stage:\", classify_stage(activity))"
      ]
    }
