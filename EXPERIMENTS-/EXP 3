            "Enter security policy text: This policy defines the scope of security activities. All employees must follow the policy. The policy is enforced by management.\n",
            "Scope: PRESENT\n",
            "Roles and Responsibilities: MISSING\n",
            "Enforcement: MISSING\n",
            "Review Cycle: MISSING\n",
            "Approval Authority: MISSING\n",
            "\n",
            "Missing Governance Elements:\n",
            "- Roles and Responsibilities\n",
            "- Enforcement\n",
            "- Review Cycle\n",
            "- Approval Authority\n"
          ]
        }
      ],
      "source": [
        "# Check required elements in a security policy\n",
        "\n",
        "policy = input(\"Enter security policy text: \").lower()\n",
        "\n",
        "requirements = {\n",
        "    \"Scope\": [\"scope\", \"applies to\", \"coverage\"],\n",
        "    \"Roles and Responsibilities\": [\"roles\", \"responsibilities\", \"accountability\"],\n",
        "    \"Enforcement\": [\"enforcement\", \"disciplinary\", \"penalties\"],\n",
        "    \"Review Cycle\": [\"review cycle\", \"review annually\", \"review every\"],\n",
        "    \"Approval Authority\": [\"approved by\", \"approval authority\", \"authorized by\"]\n",
        "}\n",
        "\n",
        "missing = []\n",
        "\n",
        "for element, keywords in requirements.items():\n",
        "    if any(word in policy for word in keywords):\n",
        "        print(element + \": PRESENT\")\n",
        "    else:\n",
        "        print(element + \": MISSING\")\n",
        "        missing.append(element)\n",
        "\n",
        "print(\"\\nMissing Governance Elements:\")\n",
        "if missing:\n",
        "    for element in missing:\n",
        "        print(\"-\", element)\n",
        "else:\n",
        "    print(\"All required elements are present.\")"
      ]
    }
